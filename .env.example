# Server-side only — set in Vercel project env (never commit a real key).
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Optional override — must be a free model (id ending in ":free"), otherwise ignored.
# OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

# Contact form delivery, via Brevo's transactional email API.
# Create a key at https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your-key-here
# Optional overrides — default to hello@kcacuin.com for both.
# CONTACT_TO=hello@kcacuin.com
# CONTACT_FROM=Portfolio <hello@kcacuin.com>
